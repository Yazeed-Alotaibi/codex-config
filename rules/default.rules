prefix_rule(pattern=["C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$checks = @('node','npm','codex','goose','codex-acp'); foreach ($c in $checks) { $cmd = Get-Command $c -ErrorAction SilentlyContinue; if ($cmd) { \"$c`t$($cmd.Source)\" } else { \"$c`tNOT FOUND\" } }"], decision="allow")
prefix_rule(pattern=["npm", "install", "--global"], decision="allow")
prefix_rule(pattern=["C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$commands = @('codex-acp','codex'); foreach ($c in $commands) { $cmd = Get-Command $c -ErrorAction SilentlyContinue; if ($cmd) { \"$c`t$($cmd.Source)\" } else { \"$c`tNOT FOUND\" } }; codex login status"], decision="allow")
prefix_rule(pattern=["git", "ls-remote"], decision="allow")
prefix_rule(pattern=["git", "clone"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$repo='C:\\Users\\PC\\codex-config-sync'; $live='C:\\Users\\PC\\.Codex'; git -C $repo ls-files | ForEach-Object { $source=Join-Path $repo $_; $target=Join-Path $live $_; if (-not (Test-Path -LiteralPath $target)) { [PSCustomObject]@{State='MISSING';Path=$_} } elseif ((Get-FileHash -Algorithm SHA256 -LiteralPath $source).Hash -ne (Get-FileHash -Algorithm SHA256 -LiteralPath $target).Hash) { [PSCustomObject]@{State='DIFFERENT';Path=$_} } } | Format-Table -AutoSize"], decision="allow")
prefix_rule(pattern=["git", "pull"], decision="allow")
